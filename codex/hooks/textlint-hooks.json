{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/.codex/hooks/textlint-stop-hook.py",
            "timeout": 120,
            "statusMessage": "textlint/prh で文章を校閲しています"
          }
        ]
      }
    ]
  }
}
